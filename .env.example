# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
# Managed Postgres on Render; for local dev use docker-compose (see docker-compose.yml)
DATABASE_URL=postgresql://deconstruct:deconstruct@localhost:5432/deconstruct?schema=public

# --- AI provider ---
# "gemini"     -> native Google SDK with strict JSON schema (default)
# "openrouter" -> OpenAI-compatible transport; also works with OpenAI, Groq,
#                 Together, or a local Ollama by changing OPENROUTER_BASE_URL
AI_PROVIDER=gemini
AI_TIMEOUT_MS=90000

# --- Google Gemini (used when AI_PROVIDER=gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- OpenRouter / OpenAI-compatible (used when AI_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Deconstruct.ai

# --- CORS ---
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# --- Google Calendar OAuth (added in Phase 3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
TOKEN_ENC_KEY=
SESSION_SECRET=
