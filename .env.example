# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
# Managed Postgres on Render; for local dev use docker-compose (see docker-compose.yml)
DATABASE_URL=postgresql://deconstruct:deconstruct@localhost:5432/deconstruct?schema=public

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- CORS ---
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# --- Google Calendar OAuth (added in Phase 3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
TOKEN_ENC_KEY=
SESSION_SECRET=
